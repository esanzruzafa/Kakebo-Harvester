# Copiar como .env.sandbox o .env.production. Nunca confirmar esos archivos.
APP_ENV=sandbox
APP_PORT=8000
APP_BASE_URL=http://localhost:8000

ENABLE_BANKING_API_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=./private/enable-banking-sandbox.pem
ENABLE_BANKING_REDIRECT_URL=http://localhost:8000/callback

DATABASE_PATH=./data/sandbox/kakebo-sandbox.sqlite
RAW_DATA_DIRECTORY=./data/sandbox/raw
EXPORT_DIRECTORY=./data/sandbox/exports

DEFAULT_COUNTRY=ES
DEFAULT_PSU_TYPE=personal
DEFAULT_LANGUAGE=es
SYNC_LOOKBACK_DAYS=15
MAX_TRANSACTION_PAGES=100
HTTP_TIMEOUT_MS=30000
LOG_LEVEL=info
RETAIN_RAW_DATA=true
CSV_SEPARATOR=;
EXPORT_KEEP_BACKUP=false

# Recomendado en Windows si una red corporativa instala su CA en el almacén del sistema.
NODE_USE_SYSTEM_CA=1

# 32 bytes aleatorios codificados en base64. Ejemplo para generarlos:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
