# Copy as private/.env.production. Never commit the resulting file.
APP_ENV=production
APP_PORT=8000
APP_BASE_URL=https://localhost:8000

ENABLE_BANKING_API_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=./enable-banking-production.pem
ENABLE_BANKING_REDIRECT_URL=https://localhost:8000/callback

APP_TLS_PFX_PATH=./local-https-production.pfx
APP_TLS_PFX_PASSPHRASE_PATH=./local-https-production.passphrase

DATABASE_PATH=../data/production/kakebo-production.sqlite
RAW_DATA_DIRECTORY=../data/production/raw
EXPORT_DIRECTORY=../data/production/exports

DEFAULT_COUNTRY=ES
DEFAULT_PSU_TYPE=personal
DEFAULT_LANGUAGE=es
SYNC_LOOKBACK_DAYS=15
# Maximum calendar-day distance allowed when a booked movement replaces a pending one.
PENDING_RECONCILIATION_WINDOW_DAYS=14
MAX_TRANSACTION_PAGES=100
MAX_BUFFERED_TRANSACTION_ROWS=10000
HTTP_TIMEOUT_MS=30000
LOG_LEVEL=info
RETAIN_RAW_DATA=true
CSV_SEPARATOR=;
EXPORT_KEEP_BACKUP=false

# Configuration paths resolved from private/.
CATEGORIZATION_RULES_PATH=../config/categorization-rules.json
ACCOUNTS_CONFIG_PATH=../config/accounts.json
CATEGORIES_CONFIG_PATH=../config/categories.json
EXPORT_SETTINGS_PATH=../config/export-settings.json
CARD_IMPORT_PROFILES_PATH=../config/card-import-profiles.json
UI_SETTINGS_PATH=../config/ui-settings.json

NODE_USE_SYSTEM_CA=1

# 32 random bytes encoded as base64.
SESSION_ENCRYPTION_KEY=
