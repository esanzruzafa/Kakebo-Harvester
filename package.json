{
  "name": "kakebo-harvester",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "dist/src/desktop/main.js",
  "description": "Local, read-only desktop application for importing financial data through Enable Banking.",
  "author": "Eduardo Sanz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esanzruzafa/Kakebo-Harvester.git"
  },
  "homepage": "https://esanzruzafa.github.io/Kakebo-Harvester/",
  "bugs": {
    "url": "https://github.com/esanzruzafa/Kakebo-Harvester/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "cli": "tsx src/index.ts",
    "build": "npm run clean:dist && npm run build:core && npm run build:assets",
    "clean:dist": "node scripts/clean-dist.mjs",
    "build:core": "tsc -p tsconfig.json",
    "build:assets": "node scripts/copy-desktop-assets.mjs && npm run verify:desktop-assets",
    "verify:desktop-assets": "node scripts/verify-desktop-assets.mjs",
    "desktop": "npm run build && electron .",
    "desktop:rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "desktop:verify-package": "set ELECTRON_RUN_AS_NODE=1&& \"release\\portable\\win-unpacked\\Kakebo Harvester.exe\" scripts\\verify-packaged-sqlite.cjs",
    "desktop:pack": "npm run build && npm run desktop:rebuild-native && electron-builder --dir --win --config.npmRebuild=false",
    "desktop:dist": "npm run build && npm run desktop:rebuild-native && electron-builder --win portable --config.npmRebuild=false --config.directories.output=release/portable && npm run desktop:verify-package && npm run desktop:package-bundle",
    "desktop:package-bundle": "node scripts/create-portable-package.mjs",
    "desktop:release": "npm run check && npm run desktop:dist",
    "desktop:installer": "npm run build && npm run desktop:rebuild-native && electron-builder --win nsis --config.npmRebuild=false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=4 --testTimeout=15000 --hookTimeout=15000",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "test:watch": "vitest",
    "setup:https": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-https.ps1",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.12.3",
    "jose": "^6.0.12",
    "pino": "^9.7.0",
    "read-excel-file": "^9.3.4",
    "safe-regex2": "^5.1.1",
    "unzipper-esm": "^0.13.3",
    "write-excel-file": "^4.1.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.5.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "fflate": "^0.8.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "@xmldom/xmldom": "0.8.15",
    "fast-uri@^3.0.0": "3.1.7",
    "fast-uri@^4.0.0": "4.1.4"
  },
  "build": {
    "appId": "com.kakeboharvester.desktop",
    "productName": "Kakebo Harvester",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ],
    "files": [
      "dist/src/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "scripts/setup-local-https.ps1",
        "to": "scripts/setup-local-https.ps1"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Kakebo Harvester",
      "artifactName": "Kakebo-Harvester-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "splashImage": "build/portable-splash.bmp"
    },
    "npmRebuild": false
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true
  }
}
